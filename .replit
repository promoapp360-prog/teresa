modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm install && npm run dev"
hidden = [".config", "dist", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --include=dev && npm run build"]
run = ["sh", "-c", "npm start"]

[workflows]
runButton = "Avvia Studio della Volpe"

[[workflows.workflow]]
name = "Avvia Studio della Volpe"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run dev"
waitForPort = 5000
