modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
run = "npm install && npm run dev"
hidden = [".config", "dist", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --include=dev && npm run build"]
run = ["sh", "-c", "npm start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Avvia Studio della Volpe"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Avvia Studio della Volpe"
