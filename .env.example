# Su Replit questi valori vanno nei "Secrets", MAI in questo file o su GitHub.
# DATABASE_URL viene creato automaticamente da Replit quando aggiungi il database PostgreSQL.
DATABASE_URL=
SESSION_SECRET=una-stringa-lunga-e-casuale
# Chiave per cifrare referti e allegati clinici (AES-256-GCM). Obbligatoria in produzione. Non cambiarla dopo il primo caricamento.
FILES_ENCRYPTION_KEY=
PUBLIC_URL=https://dominio-dello-studio.it
# Password iniziale dell'utente "Admin" (se assente: "Teresa"). Cambio obbligatorio al primo accesso.
ADMIN_INITIAL_PASSWORD=
# Email (SMTP) – senza configurazione le email vengono registrate come "simulate" e non inviate
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Studio Dott.ssa Teresa della Volpe <info@dominio-dello-studio.it>"
# Facoltativo: chiave per richiamare /api/cron da un servizio esterno (promemoria con deploy Autoscale)
CRON_SECRET=
# Facoltativo: "true" carica tre pazienti di esempio (dati inventati) per la dimostrazione
SEED_DEMO=
